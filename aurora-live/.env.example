# Generate each secret with at least 32 random bytes.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
AURORA_BOOTSTRAP_SECRET=replace-with-a-long-random-secret
AURORA_WEBHOOK_SECRET=replace-with-a-different-long-random-secret

# Exact public browser origin and accepted Host values.
AURORA_CORS_ORIGIN=https://aurora.example.com
AURORA_ALLOWED_HOSTS=aurora.example.com,localhost,127.0.0.1

# Add only the reverse proxy network or addresses you control.
AURORA_TRUSTED_PROXIES=172.16.0.0/12
AURORA_AUTH_RATE_LIMIT=10
AURORA_WRITE_RATE_LIMIT=120
AURORA_RATE_WINDOW_SECONDS=60
AURORA_MAX_BODY_BYTES=1000000
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=30

# Release source collection, metrics, and readiness.
AURORA_SOURCE_TIMEOUT_SECONDS=12
AURORA_METRICS_ENABLED=1
AURORA_REQUIRE_WORKER=1

# Background worker scheduling and delivery retry policy.
AURORA_REFRESH_INTERVAL_SECONDS=300
AURORA_DELIVERY_INTERVAL_SECONDS=10
AURORA_WORKER_LEASE_SECONDS=120
AURORA_WORKER_FAILURE_RETRY_SECONDS=30
AURORA_WORKER_STALE_SECONDS=120
AURORA_DELIVERY_MAX_ATTEMPTS=5
AURORA_DELIVERY_BACKOFF_SECONDS=30
AURORA_DELIVERY_MAX_BACKOFF_SECONDS=3600

# Phase 19 multimodal verification. Offline verification always works.
# Groq is optional, public-evidence-only, inference-only, and disabled by default.
AURORA_MEDIA_INTERVAL_SECONDS=10
AURORA_MEDIA_BATCH_SIZE=100
AURORA_GROQ_ENABLED=false
GROQ_API_KEY=
AURORA_GROQ_VISION_MODEL=qwen/qwen3.6-27b
AURORA_GROQ_DAILY_LIMIT=40
AURORA_GROQ_TIMEOUT_SECONDS=20

# Phase 20 operating picture. Sensitive mobile assets are delayed by default.
AURORA_OPERATING_INTERVAL_SECONDS=10
AURORA_OPERATING_BATCH_SIZE=1000
AURORA_SENSITIVE_TRACK_DELAY_SECONDS=86400
AURORA_TRACK_STALE_SECONDS=900

# Phase 21 route and supply-chain reassessment.
AURORA_ROUTE_INTERVAL_SECONDS=60
AURORA_ROUTE_BATCH_SIZE=100

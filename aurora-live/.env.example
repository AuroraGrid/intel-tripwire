# Generate each secret with at least 32 random bytes.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
AURORA_BOOTSTRAP_SECRET=replace-with-a-long-random-secret
AURORA_WEBHOOK_SECRET=replace-with-a-different-long-random-secret

# Exact public browser origin and accepted Host values.
AURORA_CORS_ORIGIN=https://aurora.example.com
AURORA_ALLOWED_HOSTS=aurora.example.com,localhost,127.0.0.1

# Add only the reverse proxy network or addresses you control.
AURORA_TRUSTED_PROXIES=172.16.0.0/12
AURORA_AUTH_RATE_LIMIT=10
AURORA_WRITE_RATE_LIMIT=120
AURORA_RATE_WINDOW_SECONDS=60
AURORA_MAX_BODY_BYTES=1000000
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=30

# Copy to .env and replace every value before starting a public deployment.
AURORA_PUBLIC_HOST=aurora.example.com
POSTGRES_PASSWORD=replace-with-a-long-random-password
AURORA_BOOTSTRAP_SECRET=replace-with-a-long-random-bootstrap-secret
AURORA_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=30

# AURORA works without an AI API. External model access stays disabled.
AURORA_GROQ_ENABLED=false

